# ==========================================
# 1. DATASET (CRITICAL: Stay ignored to avoid 3GB push)
# ==========================================
HAM10000_images_part_1/
HAM10000_images_part_2/
HAM10000_metadata.csv

# ==========================================
# 2. EXPERIMENT RESULTS (EXPLICITLY ALLOWED)
# ==========================================
# We tell Git NOT to ignore the results folder or the root PNGs
!results/
!results/*
!confusion_matrix.png
!training_curves.png

# Allow all model weight files (assuming they are <100MB)
!*.keras

# ==========================================
# 3. PYTHON BOILERPLATE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
venv/
env/
.venv/

# ==========================================
# 4. IDE & SYSTEM FILES
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.ipynb_checkpoints/